# ── Banco de dados ────────────────────────────────────────────────────────────
POSTGRES_USER=juridico
POSTGRES_PASSWORD=TROQUE_POR_SENHA_FORTE
POSTGRES_DB=juridico_adv

# DATABASE_URL é montada automaticamente pelo docker-compose usando as vars acima
# Não precisa preencher aqui — o compose monta: postgresql://USER:PASS@postgres:5432/DB

# ── NextAuth ─────────────────────────────────────────────────────────────────
# Gere com: openssl rand -base64 32
AUTH_SECRET=GERE_COM_openssl_rand_base64_32
AUTH_URL=https://SEU_DOMINIO

# ── E-PROC TJSC ──────────────────────────────────────────────────────────────
EPROC_TRIBUNAL=TJSC
EPROC_TJSC_USER=SEU_USUARIO
EPROC_TJSC_PASSWORD=SUA_SENHA
EPROC_TJSC_TOTP_SEED=XXXX XXXX XXXX XXXX XXXX XXXX XXXX XXXX

# ── E-PROC TJRS ──────────────────────────────────────────────────────────────
EPROC_TJRS_USER=SEU_USUARIO
EPROC_TJRS_PASSWORD=SUA_SENHA
EPROC_TJRS_TOTP_SEED=XXXX XXXX XXXX XXXX XXXX XXXX XXXX XXXX

# ── Pipeline ──────────────────────────────────────────────────────────────────
PIPELINE_ARCHIVE_DIR=/app/storage/archive
PIPELINE_INTERVAL_MS=21600000

# ── Google Drive (arquivamento automático — opcional) ────────────────────────
# Deixe GOOGLE_DRIVE_ROOT_FOLDER_ID vazio para arquivar apenas em disco local.
# Quando configurado, os documentos são enviados para o Drive na estrutura:
#   <pasta raiz>/<cliente>/<número do processo>/<documento>
#
# Setup (service account, sem login interativo):
#   1. Google Cloud Console → crie um projeto → ative a "Google Drive API"
#   2. Crie uma Service Account → gere uma chave JSON
#   3. Copie o e-mail da service account (algo@projeto.iam.gserviceaccount.com)
#   4. No Drive do escritório, compartilhe a pasta-raiz com esse e-mail (Editor)
#      (Google Workspace: use um Shared Drive e adicione a SA como membro)
#   5. Pegue o ID da pasta na URL: drive.google.com/drive/folders/<ESTE_ID>
GOOGLE_DRIVE_ROOT_FOLDER_ID=
# Conteúdo do JSON da service account (inline, em uma linha). Alternativa:
# defina GOOGLE_APPLICATION_CREDENTIALS apontando para o caminho do arquivo.
GOOGLE_SERVICE_ACCOUNT_KEY_JSON=
# GOOGLE_APPLICATION_CREDENTIALS=/app/secrets/drive-sa.json
