# ── Banco de dados ────────────────────────────────────────────────────────────
POSTGRES_USER=juridico
POSTGRES_PASSWORD=TROQUE_POR_SENHA_FORTE
POSTGRES_DB=juridico_adv

# DATABASE_URL é montada automaticamente pelo docker-compose usando as vars acima
# Não precisa preencher aqui — o compose monta: postgresql://USER:PASS@postgres:5432/DB

# ── NextAuth ─────────────────────────────────────────────────────────────────
# Gere com: openssl rand -base64 32
AUTH_SECRET=GERE_COM_openssl_rand_base64_32
AUTH_URL=https://SEU_DOMINIO

# ── E-PROC TJSC ──────────────────────────────────────────────────────────────
EPROC_TRIBUNAL=TJSC
EPROC_TJSC_USER=SEU_USUARIO
EPROC_TJSC_PASSWORD=SUA_SENHA
EPROC_TJSC_TOTP_SEED=XXXX XXXX XXXX XXXX XXXX XXXX XXXX XXXX

# ── E-PROC TJRS ──────────────────────────────────────────────────────────────
EPROC_TJRS_USER=SEU_USUARIO
EPROC_TJRS_PASSWORD=SUA_SENHA
EPROC_TJRS_TOTP_SEED=XXXX XXXX XXXX XXXX XXXX XXXX XXXX XXXX

# ── Pipeline ──────────────────────────────────────────────────────────────────
PIPELINE_ARCHIVE_DIR=/app/storage/archive
PIPELINE_INTERVAL_MS=21600000

# ── Google Drive (arquivamento automático — opcional) ────────────────────────
# Sem credenciais, arquiva apenas em disco local. Quando configurado, envia os
# documentos para o Drive na estrutura:
#   <pasta raiz>/<1ª parte do nome do cliente>/<número do processo>/<documento>
# A pasta-raiz é criada pelo próprio app (escopo drive.file).
#
# ▶ CONTA GMAIL PESSOAL → use OAuth de usuário (service account NÃO tem cota de
#   Drive própria, por isso não serve para Gmail pessoal):
#   1. Google Cloud Console → projeto → ative a "Google Drive API"
#   2. Tela de consentimento OAuth: tipo "Externo", escopo .../auth/drive.file,
#      adicione o e-mail do Richard como usuário de teste (ou publique o app —
#      drive.file é não-sensível e não exige verificação).
#   3. Credenciais → crie um "OAuth client ID" do tipo "App para computador".
#   4. Preencha CLIENT_ID/SECRET abaixo e rode: npm run drive:auth
#      → faça o login do Richard, copie o GOOGLE_OAUTH_REFRESH_TOKEN gerado.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
# Nome da pasta-raiz criada no Drive do Richard (opcional):
# GOOGLE_DRIVE_ROOT_FOLDER_NAME=Acervo Jurídico ADV
#
# ▶ GOOGLE WORKSPACE (domínio próprio) → alternativa com service account +
#   Shared Drive. Informe o ID do Shared Drive e a chave da service account:
# GOOGLE_DRIVE_ROOT_FOLDER_ID=
# GOOGLE_SERVICE_ACCOUNT_KEY_JSON=
# GOOGLE_APPLICATION_CREDENTIALS=/app/secrets/drive-sa.json
