// Prisma schema for Jurídico ADV
// Auth: NextAuth v5 with Credentials provider
generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// AUTH — NextAuth v5 compatible + custom fields
// ============================================================
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime? @map("email_verified")
  image         String?
  passwordHash  String?   @map("password_hash")
  role          Role      @default(ADVOGADO)
  ativo         Boolean   @default(true)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  accounts  Account[]
  sessions  Session[]
  processos Processo[] @relation("AdvogadoProcessos")

  tarefasResponsavel Tarefa[] @relation("TarefaResponsavel")
  tarefasCriadas     Tarefa[] @relation("TarefaCriador")
  notificacoes       Notificacao[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

enum Role {
  ADMIN
  ADVOGADO
}

// ============================================================
// DOMAIN MODELS
// ============================================================
model Cliente {
  id          String   @id @default(cuid())
  nome        String
  cpfCnpj     String?  @unique @map("cpf_cnpj")
  email       String?
  telefone    String?
  observacoes String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  processos Processo[]

  @@index([nome])
  @@map("clientes")
}

model Processo {
  id          String         @id @default(cuid())
  numero      String         @unique
  expeditId   String?        @unique @map("expedit_id")
  tribunal    String
  esfera      String?
  vara        String?
  area        String?
  fase        String?
  status      StatusProcesso @default(ATIVO)
  // Enriquecimento vindo do Expedit (ProcessoDTO).
  segredoJustica Boolean  @default(false) @map("segredo_justica")
  possivelBaixa  Boolean  @default(false) @map("possivel_baixa")
  assuntos       String[]
  marcadores     Json? // [{ nome, cor }] — para exibição com cor
  marcadorNomes  String[] @map("marcador_nomes") // espelho dos nomes, para filtro
  clienteId   String         @map("cliente_id")
  advogadoId  String?        @map("advogado_id")
  observacoes String?
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  cliente     Cliente      @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  advogado    User?        @relation("AdvogadoProcessos", fields: [advogadoId], references: [id], onDelete: SetNull)
  andamentos  Andamento[]
  documentos  Documento[]
  publicacoes Publicacao[]
  tarefas     Tarefa[]

  @@index([clienteId])
  @@index([advogadoId])
  @@index([tribunal])
  @@index([status])
  @@map("processos")
}

enum StatusProcesso {
  ATIVO
  ARQUIVADO
  SUSPENSO
  ENCERRADO
}

model Andamento {
  id         String         @id @default(cuid())
  processoId String         @map("processo_id")
  externalId String         @unique @map("external_id")
  data       DateTime
  tipo       String
  descricao  String
  fonte      FonteAndamento @default(MANUAL)
  hash       String?        @unique
  createdAt  DateTime       @default(now()) @map("created_at")

  processo   Processo    @relation(fields: [processoId], references: [id], onDelete: Cascade)
  documentos Documento[]

  @@index([processoId])
  @@index([data(sort: Desc)])
  @@index([processoId, externalId])
  @@map("andamentos")
}

enum FonteAndamento {
  MANUAL
  SCRAPER
  IMPORTACAO
  EXPEDIT
}

model Documento {
  id           String   @id @default(cuid())
  externalId   String   @unique @map("external_id")
  andamentoId  String?  @map("andamento_id")
  processoId   String   @map("processo_id")
  nome         String
  storagePath  String?  @map("storage_path")
  driveFileId  String?  @map("drive_file_id")
  driveLink    String?  @map("drive_link")
  tipo         String?
  tamanhoBytes BigInt?  @map("tamanho_bytes")
  createdAt    DateTime @default(now()) @map("created_at")

  andamento Andamento? @relation(fields: [andamentoId], references: [id], onDelete: SetNull)
  processo  Processo   @relation(fields: [processoId], references: [id], onDelete: Cascade)

  @@index([andamentoId])
  @@index([processoId])
  @@index([processoId, externalId])
  @@map("documentos")
}

// ============================================================
// EXPEDIT — Publicações (Atualizações) + Tarefas (Agenda)
// ============================================================

// Publicação capturada do Expedit. Pode existir sem processo cadastrado
// (Richard quer visualizar publicações de processos ainda não importados),
// por isso processoId é opcional.
model Publicacao {
  id                   String           @id @default(cuid())
  externalId           String           @unique @map("external_id") // hash_publicacao do Expedit
  processoId           String?          @map("processo_id")
  numProcesso          String           @map("num_processo")
  siglaDiario          String?          @map("sigla_diario")
  nomeDiario           String?          @map("nome_diario")
  esfera               String?
  uf                   String?
  comarca              String?
  orgao                String?
  vara                 String?
  dataPublicacao       DateTime         @map("data_publicacao")
  dataDisponibilizacao DateTime?        @map("data_disponibilizacao")
  tipoComunicacao      String?          @map("tipo_comunicacao")
  conteudo             String
  inteiroTeorUrl       String?          @map("inteiro_teor_url")
  insightIa            String?          @map("insight_ia")
  status               PublicacaoStatus @default(PENDENTE)
  createdAt            DateTime         @default(now()) @map("created_at")

  processo Processo? @relation(fields: [processoId], references: [id], onDelete: SetNull)
  tarefas  Tarefa[]

  @@index([numProcesso])
  @@index([status])
  @@index([dataPublicacao(sort: Desc)])
  @@map("publicacoes")
}

enum PublicacaoStatus {
  PENDENTE
  TRATADA
  DESCARTADA
}

// Tarefa/compromisso direcionada a um advogado responsável (agenda).
// Normalmente criada ao "tratar" uma publicação.
model Tarefa {
  id            String       @id @default(cuid())
  /** Id do compromisso no Expedit, quando importada da API (idempotência). */
  expeditId     String?      @unique @map("expedit_id")
  tipo          String
  titulo        String
  descricao     String?
  dataInicio    DateTime?    @map("data_inicio")
  prazoData     DateTime?    @map("prazo_data")
  prioridade    String?
  status        TarefaStatus @default(PENDENTE)
  processoId    String?      @map("processo_id")
  publicacaoId  String?      @map("publicacao_id")
  responsavelId String       @map("responsavel_id")
  criadoPorId   String       @map("criado_por_id")
  concluidoEm   DateTime?    @map("concluido_em")
  /** Id do evento espelhado no Google Calendar (sync unidirecional). */
  googleEventId String?      @map("google_event_id")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  processo    Processo?   @relation(fields: [processoId], references: [id], onDelete: SetNull)
  publicacao  Publicacao? @relation(fields: [publicacaoId], references: [id], onDelete: SetNull)
  responsavel User        @relation("TarefaResponsavel", fields: [responsavelId], references: [id], onDelete: Cascade)
  criadoPor   User        @relation("TarefaCriador", fields: [criadoPorId], references: [id], onDelete: Cascade)

  @@index([responsavelId])
  @@index([status])
  @@index([prazoData])
  @@index([publicacaoId])
  @@map("tarefas")
}

enum TarefaStatus {
  PENDENTE
  EM_ANDAMENTO
  CONCLUIDO
  CANCELADO
}

// Notificação in-app para um usuário (ex.: tarefa direcionada a um advogado parceiro).
model Notificacao {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  tipo      String // TAREFA_DIRECIONADA | PRAZO_PROXIMO | ...
  titulo    String
  descricao String?
  link      String?
  tarefaId  String?  @map("tarefa_id")
  lida      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, lida])
  @@index([userId, createdAt(sort: Desc)])
  @@map("notificacoes")
}
